---
import EmbedPlayer from "../EmbedPlayer.astro";
import Button from "./Button.astro";
import { detectEmbedType, getAspectRatio } from "../../lib/embedUtils";

interface Props {
  id: string;
  title: string;
  content: string;
  tags?: string[];
  link?: string;
  media?: string;
  embedUrl?: string;
  embedType?: string;
  bodyContent?: string;
}

const {
  id,
  title,
  content,
  tags = [],
  link,
  media,
  embedUrl,
  embedType,
  bodyContent,
} = Astro.props;

const displaySource = embedUrl || media;
const isEmbed =
  !!embedUrl ||
  (media
    ? detectEmbedType(media) !== "none" && detectEmbedType(media) !== "iframe"
    : false);
const mediaEmbedType =
  media && !embedUrl ? detectEmbedType(media) : undefined;
const ratio = isEmbed
  ? getAspectRatio(detectEmbedType(displaySource!, embedType || mediaEmbedType))
  : 1;
---

<div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
  {displaySource && (
    <div class="card-modal-media flex shrink-0 items-center justify-center bg-muted">
      <!-- Mounted by Modal.astro on open, removed on close -->
      <template data-modal-lazy>
        {isEmbed ? (
          <div
            class="w-full px-4 pb-4 pt-14 sm:px-6 sm:pb-6"
            style={`max-width: calc(var(--modal-media-h) * ${ratio} + 3rem);`}
          >
            <EmbedPlayer
              src={displaySource}
              type={embedType || mediaEmbedType}
            />
          </div>
        ) : (
          <img
            class="block max-h-[var(--modal-media-h)] w-auto max-w-full object-contain"
            src={media}
            alt={`${title} media`}
          />
        )}
      </template>
    </div>
  )}

  <div class="mx-auto w-full max-w-3xl p-6 lg:p-8">
    <h2 id={`${id}-title`} class="pr-10 text-2xl font-semibold leading-tight lg:text-3xl">
      {title}
    </h2>

    <p class="mt-3 text-sm leading-relaxed text-muted-foreground lg:text-base">
      {content}
    </p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full border border-border/60 px-2.5 py-0.5 text-xs text-muted-foreground">
            {tag}
          </span>
        ))}
      </div>
    )}

    {bodyContent && (
      <div
        class="card-modal-body mt-6 border-t border-border/40 pt-6"
        set:html={bodyContent}
      />
    )}

    {link && (
      <div class="pt-6">
        <Button as="a" href={link} target="_blank" rel="noreferrer" variant="default" size="md">
          View project →
        </Button>
      </div>
    )}
  </div>
</div>
