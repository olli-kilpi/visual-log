---
import EmbedPlayer from "../EmbedPlayer.astro";
import Modal from "./Modal.astro";
import CardModal from "./CardModal.astro";
import { detectEmbedType, getPreviewKind } from "../../lib/embedUtils";

interface Props {
  id: string;
  title: string;
  content: string;
  tags?: string[];
  link?: string;
  media?: string;
  embedUrl?: string;
  embedType?: string;
  visibility?: string;
  bodyContent?: string;
}

const {
  id,
  title,
  content,
  tags = [],
  link,
  media,
  embedUrl,
  embedType,
  visibility = "",
  bodyContent,
} = Astro.props;

const displaySource = embedUrl || media;
const isEmbed =
  !!embedUrl ||
  (media
    ? detectEmbedType(media) !== "none" && detectEmbedType(media) !== "iframe"
    : false);
const mediaEmbedType =
  media && !embedUrl ? detectEmbedType(media) : undefined;
const resolvedEmbedType = isEmbed
  ? detectEmbedType(displaySource!, embedType || mediaEmbedType)
  : "none";
const kind = getPreviewKind(resolvedEmbedType);

const modalId = `modal-${id}`;
const hasModal = !!displaySource || !!bodyContent;
// Image and motion previews open the modal themselves. Video and interactive
// previews keep their own clicks, so they get a separate expand button.
const previewOpensModal = hasModal && !!displaySource && (kind === "image" || kind === "motion");
const showExpandButton = hasModal && !!displaySource && !previewOpensModal;
const showDetailsButton = hasModal && !displaySource;
---

<article
  class="card group relative isolate flex overflow-hidden rounded-lg border border-border/60 bg-card shadow-sm transition-shadow hover:shadow-md"
  data-section
  data-kind={kind}
  data-visibility={visibility.toLowerCase()}
  data-tags={tags.map((tag) => tag.toLowerCase()).join("|")}
  id={id}
>
  <!-- Media Section -->
  <div class="card-media w-full overflow-hidden">
    {displaySource ? (
      kind === "image" ? (
        <button
          type="button"
          data-modal-target={modalId}
          class="card-image-frame block aspect-video w-full cursor-zoom-in overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
          aria-label={`Open ${title} larger`}
        >
          <img
            data-card-image
            class="card-image h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            src={media}
            alt={`${title} media`}
            loading="lazy"
          />
        </button>
      ) : (
        <div class="relative">
          <EmbedPlayer
            src={displaySource}
            type={embedType || mediaEmbedType}
          />
          {previewOpensModal && (
            <button
              type="button"
              data-modal-target={modalId}
              class="absolute inset-0 z-10 cursor-zoom-in rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
              aria-label={`Open ${title} larger`}
            ></button>
          )}
          {kind === "interactive" && (
            <span class="pointer-events-none absolute left-3 top-3 z-10 rounded-full bg-accent px-2.5 py-0.5 text-xs font-medium text-accent-foreground shadow-sm">
              Interactive
            </span>
          )}
        </div>
      )
    ) : (
      <div class="aspect-video w-full overflow-hidden bg-muted flex items-center justify-center">
        <svg
          class="h-16 w-16 text-muted-foreground/30"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
      </div>
    )}
  </div>

  {previewOpensModal && (
    <span
      class="pointer-events-none absolute right-3 top-3 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-card text-foreground opacity-0 shadow-sm transition-opacity group-hover:opacity-100"
      aria-hidden="true"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" />
      </svg>
    </span>
  )}

  <!-- Content Section -->
  <div class="card-content relative z-10 flex flex-1 flex-col gap-3 p-6">
    <h2 class="text-xl font-semibold leading-tight md:text-2xl">{title}</h2>
    <p class="flex-1 text-sm leading-relaxed text-muted-foreground md:text-base">
      {content}
    </p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full border border-border/60 px-2.5 py-0.5 text-xs text-muted-foreground">
            {tag}
          </span>
        ))}
      </div>
    )}
    <div class="flex items-center gap-3">
      {showExpandButton && (
        <button
          type="button"
          data-modal-target={modalId}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" />
          </svg>
          Expand
        </button>
      )}
      {showDetailsButton && (
        <button
          type="button"
          data-modal-target={modalId}
          class="inline-flex items-center text-sm font-medium text-accent hover:underline"
        >
          Details →
        </button>
      )}
      {link && (
        <a
          class="inline-flex items-center text-sm font-medium text-accent hover:underline"
          href={link}
          target="_blank"
          rel="noreferrer"
        >
          View project →
        </a>
      )}
    </div>
  </div>
</article>

{hasModal && (
  <Modal id={modalId} class="sm:!max-w-6xl sm:!max-h-[92vh]">
    <CardModal
      id={id}
      title={title}
      content={content}
      tags={tags}
      link={link}
      media={media}
      embedUrl={embedUrl}
      embedType={embedType}
      bodyContent={bodyContent}
    />
  </Modal>
)}

<script>
  // Tall images run under the text section (frosted). Image size is only
  // known once the external file has loaded.
  function markOrientation(img: HTMLImageElement) {
    if (!img.naturalWidth) return;
    const card = img.closest<HTMLElement>(".card");
    if (card && img.naturalHeight > img.naturalWidth * 1.05) {
      card.dataset.orientation = "portrait";
    }
  }

  document.querySelectorAll<HTMLImageElement>("img[data-card-image]").forEach((img) => {
    if (img.complete) markOrientation(img);
    else img.addEventListener("load", () => markOrientation(img), { once: true });
  });

  // Opening a video in the modal stops the card's own player, so only one plays.
  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element | null)?.closest?.(".card[data-kind='video'] [data-modal-target]");
    const card = trigger?.closest(".card");
    if (!card) return;
    card.querySelectorAll("video").forEach((video) => video.pause());
    card.querySelectorAll("iframe").forEach((iframe) => {
      iframe.src = iframe.src;
    });
  });
</script>
